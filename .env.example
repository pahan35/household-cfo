# Placeholders only. Never put a real credential in this file.
#
# Preferred for local macOS development: store credentials in the macOS keychain,
# so no secrets are persisted in the repository. Run these in your terminal:
#
#   security add-generic-password -a "$USER" -s external-api-web-cookie -w
#   security add-generic-password -a "$USER" -s external-api-web-user -w
#   security add-generic-password -a "$USER" -s external-api-token -w
#
# Credential Source Control:
# "keychain" (default): reads from macOS Keychain (external-api-web-cookie, external-api-web-user, external-api-token).
# "env": reads from environment variables below without invoking macOS Keychain (for Vercel / serverless deployments).
EXTERNAL_API_SECRET_SOURCE=keychain

# ExternalProvider Environment Mode Credentials (used when EXTERNAL_API_SECRET_SOURCE=env)
# In production on Vercel, set these in encrypted project environment variables.
EXTERNAL_API_WEB_COOKIE=
EXTERNAL_API_WEB_USER=
# Optional fallback legacy Bearer token
EXTERNAL_API_TOKEN=

# Google OAuth & Family Access Control
# In production on Vercel, set these in project environment variables.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 32+ byte secret used to sign session cookies
AUTH_SECRET=your-random-32-byte-secret-key-change-in-prod
# Comma-separated list of allowed family member email addresses
ALLOWED_USER_EMAILS=owner@example.com,wife@example.com
# Local development bypass: defaults to "true" outside Vercel, set to "false" to test OAuth locally.
# Hard fail-closed: setting this to "true" on Vercel or in production fails build/execution.
AUTH_BYPASS_LOCAL=true
# Canonical production URL registered in Google Cloud Console for OAuth redirect relay from dynamic Preview deployments.
# e.g. https://family-budget.vercel.app or https://budget.yourdomain.com
AUTH_CANONICAL_URL=
# Optional comma-separated allowlist of custom preview origins (defaults to *.vercel.app and localhost in dev)
ALLOWED_PREVIEW_ORIGINS=

# Persistent Database & Scheduled Sync (Supabase PostgreSQL / Vercel Cron)
# Set DATABASE_URL or SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY to enable server-side persistence.
# In local dev/tests, omitting these falls back to local file/memory storage.
DATABASE_URL=
SUPABASE_URL=
# New Supabase Secret API key (starts with sb_secret_...) or legacy SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for Vercel Cron scheduled endpoint (/api/external-provider/cron/daily-sync)
CRON_SECRET=

# Mobile / external API access to /api/v1/* (server-only, never NEXT_PUBLIC_)
# Comma-separated "label:token" pairs (or bare tokens). Generate long random values per client.
MOBILE_API_TOKENS=

# Application Mode
# "focused": Exposes only Family Budget navigation, routes, and branding (default in production / Vercel).
# "full": Exposes Family Budget plus upstream template demo dashboards, pages, and mock users (default in local dev).
NEXT_PUBLIC_APP_MODE=
